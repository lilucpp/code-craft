cmake_minimum_required(VERSION 3.20)
project(ModernCppTestingSuite LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

# --- 1. Testing & Verification Options ---
option(BUILD_TESTING "Build unit tests" ON)
option(ENABLE_SANITIZERS "Enable AddressSanitizer & UBSan" ON)
option(ENABLE_COVERAGE "Enable code coverage flags" OFF)

# --- 2. Dual Sanitizers Configuration ---
if(ENABLE_SANITIZERS AND CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
    message(STATUS "[Security] AddressSanitizer and UndefinedBehaviorSanitizer ENABLED")
    add_compile_options(
        -fsanitize=address,undefined
        -fno-omit-frame-pointer
        -fno-common
        -g
    )
    add_link_options(-fsanitize=address,undefined)
endif()

# --- 3. Code Coverage Configuration ---
if(ENABLE_COVERAGE AND CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    message(STATUS "[Coverage] Code coverage flags ENABLED")
    add_compile_options(--coverage -O0 -g)
    add_link_options(--coverage)
endif()

# --- 4. GoogleTest via FetchContent ---
if(BUILD_TESTING)
    enable_testing()

    include(FetchContent)
    FetchContent_Declare(
        googletest
        GIT_REPOSITORY https://github.com/google/googletest.git
        GIT_TAG        v1.14.0
    )
    # Prevent GoogleTest from installing alongside target project
    set(gtest_force_shared_crt ON CACHE BOOL "" FORCE)
    set(INSTALL_GTEST OFF CACHE BOOL "" FORCE)
    FetchContent_MakeAvailable(googletest)

    include(GoogleTest)

    # --- 5. Reusable Test Registration Function (fmt-style) ---
    function(add_unit_test test_name)
        add_executable(${test_name} ${ARGN})

        target_link_libraries(${test_name} PRIVATE
            GTest::gtest
            GTest::gmock
            GTest::gtest_main
        )

        # Automatic CTest Discovery
        gtest_discover_tests(${test_name}
            PROPERTIES
            TIMEOUT 30
        )
    endfunction()

    # --- 6. Declare Test Binaries ---
    add_unit_test(test_account_service tests/test_account_service_gmock.cpp)
    add_unit_test(test_parameterized tests/test_parameterized_suite.cpp)
endif()
