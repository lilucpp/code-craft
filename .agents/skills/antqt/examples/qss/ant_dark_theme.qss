/* ===================================================================
 * Ant Design Dark Theme QSS for Desktop Applications (v5.0 Spec)
 * Surface Layout: #141414 | Surface Container: #1F1F1F | Border: #424242 / #303030
 * Primary: #1668DC | Base Font: 14px | Control Height: 32px | Radius: 6px
 * =================================================================== */

/* --- 1. Global Reset & Typography --- */
QWidget {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.85);
    selection-background-color: #11356F;
    selection-color: #FFFFFF;
}

QMainWindow, QDialog, QWidget#centralWidget {
    background-color: #141414;
}

QDialog {
    background-color: #1F1F1F;
}

/* Secondary & Sub Text */
QLabel[type="secondary"] {
    color: rgba(255, 255, 255, 0.55);
    font-size: 13px;
}
QLabel[type="muted"] {
    color: rgba(255, 255, 255, 0.45);
    font-size: 12px;
}
QLabel[type="title-lg"] {
    font-size: 20px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.95);
}
QLabel[type="title-md"] {
    font-size: 16px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.90);
}

/* --- 2. Containers & Cards --- */
QFrame[type="card"] {
    background-color: #1F1F1F;
    border: 1px solid #303030;
    border-radius: 8px;
}

/* --- 3. Buttons --- */
QPushButton {
    min-height: 32px;
    max-height: 32px;
    padding: 4px 15px;
    font-size: 14px;
    font-weight: 400;
    border-radius: 6px;
    border: 1px solid #424242;
    background-color: #1F1F1F;
    color: rgba(255, 255, 255, 0.85);
    outline: none;
}

QPushButton:hover {
    color: #3C89E8;
    border-color: #3C89E8;
    background-color: #1F1F1F;
}

QPushButton:pressed {
    color: #1554AD;
    border-color: #1554AD;
    background-color: #262626;
}

QPushButton:disabled {
    color: rgba(255, 255, 255, 0.25);
    border-color: #303030;
    background-color: #141414;
}

/* Primary Button */
QPushButton[type="primary"] {
    background-color: #1668DC;
    border: 1px solid #1668DC;
    color: #FFFFFF;
    font-weight: 500;
}
QPushButton[type="primary"]:hover {
    background-color: #3C89E8;
    border-color: #3C89E8;
}
QPushButton[type="primary"]:pressed {
    background-color: #1554AD;
    border-color: #1554AD;
}
QPushButton[type="primary"]:disabled {
    background-color: #262626;
    border-color: #303030;
    color: rgba(255, 255, 255, 0.3);
}

/* Danger Button */
QPushButton[type="danger"] {
    background-color: #D32029;
    border: 1px solid #D32029;
    color: #FFFFFF;
    font-weight: 500;
}
QPushButton[type="danger"]:hover {
    background-color: #E84749;
    border-color: #E84749;
}

/* Dashed Button */
QPushButton[type="dashed"] {
    border: 1px dashed #424242;
    background-color: #1F1F1F;
    color: rgba(255, 255, 255, 0.85);
}
QPushButton[type="dashed"]:hover {
    border-color: #3C89E8;
    color: #3C89E8;
}

/* Text & Link Button */
QPushButton[type="text"] {
    border: none;
    background-color: transparent;
    color: rgba(255, 255, 255, 0.85);
}
QPushButton[type="text"]:hover {
    background-color: rgba(255, 255, 255, 0.08);
}
QPushButton[type="link"] {
    border: none;
    background-color: transparent;
    color: #1668DC;
}
QPushButton[type="link"]:hover {
    color: #3C89E8;
}

/* Close Icon Button */
QPushButton[type="close"] {
    border: none;
    background: transparent;
    color: rgba(255, 255, 255, 0.45);
    font-size: 16px;
    border-radius: 4px;
}
QPushButton[type="close"]:hover {
    color: #FFFFFF;
    background-color: rgba(255, 255, 255, 0.1);
}

/* --- 4. Inputs & Forms (32px Height) --- */
QLineEdit, QSpinBox, QDoubleSpinBox {
    min-height: 32px;
    max-height: 32px;
    padding: 0 11px;
    font-size: 14px;
    border: 1px solid #424242;
    border-radius: 6px;
    background-color: #1F1F1F;
    color: rgba(255, 255, 255, 0.85);
}

QSpinBox, QDoubleSpinBox {
    padding-right: 24px;
}

QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #3C89E8;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #1668DC;
}

QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: #141414;
    color: rgba(255, 255, 255, 0.25);
    border-color: #303030;
}

/* Ant Design Dark SpinBox Step Buttons */
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 22px;
    height: 15px;
    border-left: 1px solid #424242;
    border-bottom: 1px solid #424242;
    border-top-right-radius: 5px;
    background-color: #262626;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover {
    background-color: #11356F;
}
QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed {
    background-color: #1554AD;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(":/qss/icons/spin_up_dark.png");
    width: 9px;
    height: 7px;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 22px;
    height: 15px;
    border-left: 1px solid #424242;
    border-bottom-right-radius: 5px;
    background-color: #262626;
}
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #11356F;
}
QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed {
    background-color: #1554AD;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(":/qss/icons/spin_down_dark.png");
    width: 9px;
    height: 7px;
}

QLineEdit[status="error"] {
    border: 1px solid #D32029;
}
QLineEdit[status="warning"] {
    border: 1px solid #D89614;
}

/* --- 5. ComboBox --- */
QComboBox {
    min-height: 32px;
    max-height: 32px;
    padding: 0 11px;
    font-size: 14px;
    border: 1px solid #424242;
    border-radius: 6px;
    background-color: #1F1F1F;
    color: rgba(255, 255, 255, 0.85);
}
QComboBox:hover {
    border-color: #3C89E8;
}
QComboBox:focus, QComboBox:on {
    border: 1px solid #1668DC;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 26px;
    border: none;
}
QComboBox::down-arrow {
    image: url(":/qss/icons/select_down_dark.png");
    width: 10px;
    height: 10px;
    margin-right: 8px;
}
QComboBox QAbstractItemView {
    border: 1px solid #303030;
    border-radius: 6px;
    background-color: #1F1F1F;
    selection-background-color: #11356F;
    selection-color: #FFFFFF;
    padding: 4px;
    outline: none;
}
QComboBox QAbstractItemView::item {
    min-height: 30px;
    padding: 4px 10px;
    border-radius: 4px;
    color: rgba(255, 255, 255, 0.85);
}

/* --- 6. TableWidget --- */
QTableWidget, QTableView {
    background-color: #1F1F1F;
    border: 1px solid #303030;
    border-radius: 6px;
    gridline-color: #303030;
    outline: none;
    selection-background-color: #11356F;
    selection-color: #FFFFFF;
}

QTableWidget::item {
    padding: 8px 12px;
    border-bottom: 1px solid #303030;
    color: rgba(255, 255, 255, 0.85);
}

QTableWidget::item:hover {
    background-color: #262626;
}

QTableWidget::item:selected {
    background-color: #11356F;
    color: #FFFFFF;
}

QHeaderView::section {
    background-color: #1D1D1D;
    color: rgba(255, 255, 255, 0.85);
    font-weight: 600;
    font-size: 13px;
    border: none;
    border-bottom: 1px solid #303030;
    min-height: 44px;
    max-height: 44px;
    padding-left: 12px;
}

/* --- 6.1 TreeWidget & ListWidget --- */
QTreeWidget, QListView, QListWidget {
    background-color: #1F1F1F;
    border: 1px solid #303030;
    border-radius: 6px;
    outline: none;
    padding: 4px;
}

QTreeWidget::item, QListWidget::item {
    min-height: 32px;
    padding: 4px 8px;
    border-radius: 4px;
    color: rgba(255, 255, 255, 0.85);
}

QTreeWidget::item:hover, QListWidget::item:hover {
    background-color: #262626;
    color: #3C89E8;
}

QTreeWidget::item:selected, QListWidget::item:selected {
    background-color: #11356F;
    color: #FFFFFF;
    font-weight: 500;
}

QTreeWidget::branch:has-children:!has-siblings:closed,
QTreeWidget::branch:closed:has-children:has-siblings {
    image: url(":/qss/icons/tree_closed_dark.png");
}
QTreeWidget::branch:open:has-children:!has-siblings,
QTreeWidget::branch:open:has-children:has-siblings {
    image: url(":/qss/icons/tree_open_dark.png");
}

/* --- 6.2 Pagination Controls --- */
QPushButton[type="page-btn"] {
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    padding: 0;
    font-size: 13px;
    border-radius: 6px;
    border: 1px solid #424242;
    background-color: #1F1F1F;
    color: rgba(255, 255, 255, 0.85);
}
QPushButton[type="page-btn"]:hover {
    border-color: #3C89E8;
    color: #3C89E8;
}
QPushButton[type="page-btn"][active="true"] {
    border-color: #1668DC;
    background-color: #1668DC;
    color: #FFFFFF;
    font-weight: 600;
}
QPushButton[type="page-btn"]:disabled {
    border-color: #303030;
    background-color: #141414;
    color: rgba(255, 255, 255, 0.25);
}

/* --- 7. CheckBox & Radio --- */
QCheckBox, QRadioButton {
    spacing: 8px;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.85);
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #424242;
    border-radius: 4px;
    background-color: #1F1F1F;
}
QCheckBox::indicator:hover {
    border-color: #1668DC;
}
QCheckBox::indicator:checked {
    border-color: #1668DC;
    background-color: #1668DC;
}
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #424242;
    border-radius: 8px;
    background-color: #1F1F1F;
}
QRadioButton::indicator:hover {
    border-color: #1668DC;
}
QRadioButton::indicator:checked {
    border-color: #1668DC;
    background-color: #1668DC;
}

/* --- 8. Status Tags (Dark Ant Specs) --- */
QLabel[tag="processing"] {
    background-color: #111D2C;
    border: 1px solid #153450;
    color: #1668DC;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 12px;
    font-weight: 500;
}
QLabel[tag="success"] {
    background-color: #162312;
    border: 1px solid #274916;
    color: #49AA19;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 12px;
    font-weight: 500;
}
QLabel[tag="warning"] {
    background-color: #2B2111;
    border: 1px solid #594214;
    color: #D89614;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 12px;
    font-weight: 500;
}
QLabel[tag="error"] {
    background-color: #2A1215;
    border: 1px solid #58181C;
    color: #D32029;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 12px;
    font-weight: 500;
}
QLabel[tag="default"] {
    background-color: #1D1D1D;
    border: 1px solid #424242;
    color: rgba(255, 255, 255, 0.45);
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 12px;
    font-weight: 500;
}

/* --- 9. Alert Banner --- */
QFrame[type="alert-info"] {
    background-color: #111D2C;
    border: 1px solid #153450;
    border-radius: 6px;
    padding: 8px 12px;
}
QFrame[type="alert-info"] QLabel {
    color: rgba(255, 255, 255, 0.85);
}

/* --- 10. Scrollbar --- */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 6px;
}
QScrollBar::handle:vertical {
    background: #424242;
    border-radius: 3px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: #5A5A5A;
}
